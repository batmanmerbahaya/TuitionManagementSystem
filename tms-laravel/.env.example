APP_NAME="Anjung Ilmu TMS"
APP_TIMEZONE=Asia/Kuala_Lumpur
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tms
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP for the password-reset OTP emails.
# Set MAIL_MAILER=log to write emails to storage/logs/laravel.log instead of sending them.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-gmail-address@gmail.com
MAIL_PASSWORD="your-gmail-app-password"
MAIL_FROM_ADDRESS="your-gmail-address@gmail.com"
MAIL_FROM_NAME="Anjung Ilmu System"

# Tuition centre details (receipts and the payment page) - see config/tms.php
TMS_CENTRE_NAME="Pusat Tuisyen Anjung Ilmu Pendeta"
TMS_CENTRE_ADDRESS="Anjung Ilmu, Pusat Bandar Seremban, Negeri Sembilan"
TMS_CENTRE_PHONE="+60 6-761 0649"
TMS_CENTRE_EMAIL="pusattuisyenanjungilmupendeta@gmail.com"
TMS_REGISTRATION_FEE=15
TMS_BANK_NAME="Bank Islam / DuitNow"
TMS_ACCOUNT_NAME="Pusat Tusyen Anjung Ilmu"
TMS_ACCOUNT_NUMBER=
# Text inside the centre's DuitNow QR code (scan it with any QR reader). Empty = show bank details only.
TMS_DUITNOW_QR=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
